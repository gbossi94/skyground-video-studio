# Configuration of Skyground Video Studio.
# Copy to `.env` only if you use a tool that loads it: the application reads the
# environment directly. Never commit a filled in copy — `.env` is ignored by Git.
#
# A local checkout needs NONE of these values: without configuration the studio
# runs in single user mode on SQLite and on the local disk.

# local | production
SKYGROUND_ENV=local

# Where the projects/ directory lives. Defaults to the checkout.
# SKYGROUND_WORKSPACE_ROOT=/percorso/del/checkout

# PostgreSQL in production, SQLite locally (the default).
# SKYGROUND_DATABASE_URL=postgresql://utente:password@host:5432/skyground

# Signs session cookies and local media links. Required in production, at least
# 32 characters. Generate one with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# SKYGROUND_SECRET_KEY=

# open (single local user) | password (email and password). Production requires password.
# SKYGROUND_AUTH_MODE=open

# local (disk) | s3 (Cloudflare R2 or any S3 compatible endpoint).
# SKYGROUND_STORAGE_BACKEND=local
# SKYGROUND_STORAGE_ROOT=./.skyground/storage

# Cloudflare R2. Create the bucket and an API token with read and write on it.
# SKYGROUND_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# SKYGROUND_S3_BUCKET=skyground
# SKYGROUND_S3_REGION=auto
# SKYGROUND_S3_ACCESS_KEY_ID=
# SKYGROUND_S3_SECRET_ACCESS_KEY=
# Optional: public domain in front of the bucket, used instead of signing.
# SKYGROUND_S3_PUBLIC_BASE_URL=

# Session and signed URL lifetimes.
# SKYGROUND_SESSION_TTL_HOURS=336
# SKYGROUND_SIGNED_URL_TTL_SECONDS=900

# Serving.
# SKYGROUND_HOST=127.0.0.1
# SKYGROUND_PORT=4173
# SKYGROUND_COOKIE_SECURE=false
# Extra origins allowed to perform writes, comma separated.
# SKYGROUND_ALLOWED_ORIGINS=

# Worker.
# SKYGROUND_WORKER_POLL_SECONDS=2
# SKYGROUND_WORKER_JOB_TIMEOUT_SECONDS=3600

# Binaries used by the render pipeline, when they are not on PATH.
# FFMPEG_BIN=
# HYPERFRAMES_BIN=

# Speech to text. 'local' runs Whisper in the worker (no key, slower);
# 'deepgram' uses the API; 'fixture:<percorso>' replays a transcript on disk.
# SKYGROUND_TRANSCRIPTION_PROVIDER=local
# SKYGROUND_TRANSCRIPTION_MODEL=small
# SKYGROUND_TRANSCRIPTION_API_KEY=

# Codec of the preview proxy: h264 (ogni browser) oppure vp9.
# SKYGROUND_PROXY_CODEC=h264

# Adviser che segnala le riformulazioni. 'none' oppure 'claude'.
# SKYGROUND_ADVISER_PROVIDER=none
# SKYGROUND_ADVISER_MODEL=claude-opus-5
# SKYGROUND_ADVISER_API_KEY=

# Amministratore creato all'avvio, se quell'indirizzo non ha già un account.
# Serve a chi deve entrare senza rivendicare l'istanza dalla pagina. Un account
# che esiste non viene mai toccato: né la password, né i permessi.
# SKYGROUND_ADMIN_EMAIL=
# SKYGROUND_ADMIN_PASSWORD=
